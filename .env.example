# TideTrace Environment Configuration Template
# Copy this file to .env and adjust variables as required. Never commit real secrets.

# PostgreSQL Connection String (SQLAlchemy 2.x psycopg driver format)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5433/tidetrace

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# JWT Authentication
# Secret key used for signing bearer tokens. Replace with a secure random key in production.
JWT_SECRET_KEY=tidetrace_insecure_development_secret_key_replace_in_production_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PROJECT_NAME=TideTrace
