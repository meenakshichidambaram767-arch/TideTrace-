{
  "openapi": "3.1.0",
  "info": {
    "title": "TideTrace API",
    "version": "1.0.0",
    "description": "REST API for ocean sensor ingestion, quality checks, append-only revisions and reproducible analyses."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": [
                  "object",
                  "array",
                  "null"
                ]
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "StationCreate": {
        "type": "object",
        "required": [
          "station_name",
          "latitude",
          "longitude"
        ],
        "properties": {
          "station_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "water_depth_m": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "ObservationInput": {
        "type": "object",
        "required": [
          "sensor_id",
          "event_time",
          "parameter_code",
          "raw_value",
          "unit",
          "source_system",
          "source_message_id"
        ],
        "properties": {
          "sensor_id": {
            "type": "integer"
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "parameter_code": {
            "type": "string",
            "enum": [
              "temperature",
              "salinity",
              "ph",
              "dissolved_oxygen"
            ]
          },
          "raw_value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "source_system": {
            "type": "string"
          },
          "source_message_id": {
            "type": "string"
          },
          "payload_hash": {
            "type": "string"
          }
        }
      },
      "IngestionBatch": {
        "type": "object",
        "required": [
          "atomic",
          "records"
        ],
        "properties": {
          "atomic": {
            "type": "boolean",
            "default": true
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5000,
            "items": {
              "$ref": "#/components/schemas/ObservationInput"
            }
          }
        }
      },
      "RevisionCreate": {
        "type": "object",
        "required": [
          "accepted_value",
          "decision",
          "reason"
        ],
        "properties": {
          "accepted_value": {
            "type": "number"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "corrected",
              "rejected",
              "needs_review"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "calibration_id": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "AnalysisCreate": {
        "type": "object",
        "required": [
          "analysis_name",
          "metric",
          "filters"
        ],
        "properties": {
          "analysis_name": {
            "type": "string"
          },
          "metric": {
            "type": "string",
            "enum": [
              "mean",
              "min",
              "max",
              "count",
              "median",
              "standard_deviation"
            ]
          },
          "filters": {
            "type": "object",
            "properties": {
              "sensor_ids": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "parameter_code": {
                "type": "string"
              },
              "from_time": {
                "type": "string",
                "format": "date-time"
              },
              "to_time": {
                "type": "string",
                "format": "date-time"
              },
              "revision_policy": {
                "type": "string",
                "enum": [
                  "latest_accepted_at_run",
                  "raw_only"
                ]
              }
            }
          },
          "query_version": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "save_input_manifest": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service/database status"
          }
        }
      }
    },
    "/stations": {
      "get": {
        "summary": "List stations",
        "responses": {
          "200": {
            "description": "Paginated station list"
          }
        }
      },
      "post": {
        "summary": "Create station",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Station created"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/sensors": {
      "get": {
        "summary": "List sensors",
        "parameters": [
          {
            "name": "station_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sensor_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated sensors"
          }
        }
      },
      "post": {
        "summary": "Register sensor",
        "responses": {
          "201": {
            "description": "Sensor registered"
          }
        }
      }
    },
    "/observations": {
      "get": {
        "summary": "Search observations",
        "parameters": [
          {
            "name": "sensor_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parameter_code",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from_time",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to_time",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "quality_flag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observation list"
          }
        }
      }
    },
    "/observations/{observation_id}": {
      "parameters": [
        {
          "name": "observation_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get observation detail",
        "responses": {
          "200": {
            "description": "Observation detail"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/ingestion/batches": {
      "post": {
        "summary": "Ingest batch atomically/idempotently",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestionBatch"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Batch processed"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/observations/{observation_id}/quality-tests": {
      "parameters": [
        {
          "name": "observation_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Run quality tests",
        "responses": {
          "200": {
            "description": "Quality results"
          },
          "404": {
            "description": "Observation not found"
          }
        }
      }
    },
    "/quality-rules": {
      "get": {
        "summary": "List quality rules",
        "responses": {
          "200": {
            "description": "Rules"
          }
        }
      },
      "post": {
        "summary": "Create a quality rule version",
        "responses": {
          "201": {
            "description": "Rule created"
          }
        }
      }
    },
    "/observations/{observation_id}/revisions": {
      "parameters": [
        {
          "name": "observation_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "List revision history",
        "responses": {
          "200": {
            "description": "Revision history"
          }
        }
      },
      "post": {
        "summary": "Append a measurement revision",
        "parameters": [
          {
            "name": "If-Match-Revision",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevisionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Revision created"
          },
          "409": {
            "description": "Stale revision conflict"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/analyses": {
      "get": {
        "summary": "List analysis runs",
        "responses": {
          "200": {
            "description": "Analysis list"
          }
        }
      },
      "post": {
        "summary": "Create reproducible analysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Analysis created"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/analyses/{analysis_id}": {
      "parameters": [
        {
          "name": "analysis_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get analysis and input manifest",
        "responses": {
          "200": {
            "description": "Analysis detail"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/analyses/{analysis_id}/replay": {
      "parameters": [
        {
          "name": "analysis_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Replay using stored input versions",
        "responses": {
          "200": {
            "description": "Replay comparison"
          },
          "404": {
            "description": "Analysis not found"
          }
        }
      }
    },
    "/audit-events": {
      "get": {
        "summary": "Search audit events",
        "parameters": [
          {
            "name": "entity_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from_time",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to_time",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit event list"
          }
        }
      }
    }
  }
}